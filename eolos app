function AIScanPage() {
  const [phase,setPhase]=useState("idle");
  const [prog,setProg]=useState(0);
  const [sy,setSy]=useState(0);
  const [res,setRes]=useState(null);
  const raf=useRef(null),t0=useRef(null);
  const scan=useCallback(()=>{
    if(phase==="scanning")return;
    vibe("med");
    setPhase("scanning");setRes(null);setProg(0);setSy(0);
    t0.current=performance.now();
    const D=3400;
    const tick=now=>{
      const p=Math.min((now-t0.current)/D,1);
      setProg(Math.round(p*100));setSy(p*220);
      if(p<1){raf.current=requestAnimationFrame(tick);}
      else{setPhase("done");vibe("heavy");setRes({den:73,par:"0.3μm",eff:"99.97%",days:Math.round(73/DECAY)});}
    };
    raf.current=requestAnimationFrame(tick);
  },[phase]);
  useEffect(()=>()=>cancelAnimationFrame(raf.current),[]);
  const scanning=phase==="scanning";
  const corners=[[0,0],[1,0],[0,1],[1,1]];
  return (
    <div style={{padding:"0 16px 16px"}}>
      <div style={{paddingTop:"max(52px, env(safe-area-inset-top, 20px))",paddingBottom:18}}>
        <p style={{fontSize:10,letterSpacing:3,color:"rgba(255,255,255,0.28)",fontWeight:600,marginBottom:4}}>NEURAL ANALYSIS</p>
        <h1 style={{fontSize:24,fontWeight:800,letterSpacing:-0.8}}>AI <span style={{color:EM}}>Scan</span></h1>
      </div>
      <Glass glow style={{marginBottom:14,overflow:"hidden"}} p={0}>
        <div style={{position:"relative",height:260,background:"#030d07",overflow:"hidden"}}>
          <svg style={{position:"absolute",inset:0,width:"100%",height:"100%"}} viewBox="0 0 400 260" preserveAspectRatio="none">
            {Array.from({length:11},(_,i)=><line key={`v${i}`} x1={i*40} y1="0" x2={i*40} y2="260" stroke="rgba(16,185,129,0.07)" strokeWidth=".5"/>)}
            {Array.from({length:7},(_,i)=><line key={`h${i}`} x1="0" y1={i*40} x2="400" y2={i*40} stroke="rgba(16,185,129,0.07)" strokeWidth=".5"/>)}
          </svg>
          <div style={{position:"absolute",inset:"26px 34px",display:"grid",gridTemplateColumns:"repeat(18,1fr)",gridTemplateRows:"repeat(10,1fr)",gap:2}}>
            {Array.from({length:180},(_,i)=>{
              const sat=res&&i>=132,lit=scanning&&i<=(prog/100)*180;
              return <div key={i} style={{borderRadius:1,background:sat?"rgba(239,68,68,0.62)":phase==="done"?"rgba(16,185,129,0.72)":lit?"rgba(16,185,129,0.45)":"rgba(255,255,255,0.07)",transition:phase==="done"?"background 0.4s":"none"}}/>;
            })}
          </div>
          {scanning&&<div style={{position:"absolute",left:0,right:0,top:26+sy,height:3,background:`linear-gradient(90deg,transparent 3%,${EM}bb 35%,${EM} 50%,${EM}bb 65%,transparent 97%)`,boxShadow:`0 0 18px ${EM}`,pointerEvents:"none",willChange:"top"}}/>}
          {corners.map(([x,y],i)=>(
            <div key={i} style={{position:"absolute",width:26,height:26,top:y?"auto":12,bottom:y?12:"auto",left:x?"auto":12,right:x?12:"auto",borderTop:y?"none":`2px solid ${EM}`,borderBottom:y?`2px solid ${EM}`:"none",borderLeft:x?"none":`2px solid ${EM}`,borderRight:x?`2px solid ${EM}`:"none",opacity:0.85}}/>
          ))}
          <div style={{position:"absolute",bottom:0,left:0,right:0,padding:"8px 16px",background:"rgba(0,0,0,0.7)",backdropFilter:"blur(8px)",WebkitBackdropFilter:"blur(8px)",display:"flex",justifyContent:"space-between",alignItems:"center"}}>
            <span style={{fontSize:10,letterSpacing:2,color:EM,fontWeight:700}}>{scanning?`SCANNING ${prog}%`:phase==="done"?"● COMPLETE":"○ READY"}</span>
            {scanning&&<div style={{width:72,height:3,background:"rgba(255,255,255,0.1)",borderRadius:2,overflow:"hidden"}}><div style={{height:"100%",width:`${prog}%`,background:EM}}/></div>}
          </div>
        </div>
      </Glass>
      {res&&(
        <Glass glow style={{marginBottom:14}} p={16}>
          <p style={{fontSize:10,letterSpacing:2,color:EM,fontWeight:700,marginBottom:12}}>● FILTER ANALYSIS — BS-120G-V2</p>
          <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}}>
            {[["Filter Density",`${res.den}%`,res.den>60?EM:"#F59E0B"],["Particle Size",res.par,EM],["Efficiency",res.eff,EM],["Days Left",`${res.days}d`,res.days>60?EM:"#F59E0B"]].map(([lb,vl,col])=>(
              <div key={lb} style={{padding:"12px 14px",background:"rgba(16,185,129,0.05)",borderRadius:12,border:"1px solid rgba(16,185,129,0.12)"}}>
                <p style={{fontSize:9,color:"rgba(255,255,255,0.32)",letterSpacing:1.5,fontWeight:600,marginBottom:5}}>{lb.toUpperCase()}</p>
                <p style={{fontSize:19,fontWeight:800,color:col}}>{vl}</p>
              </div>
            ))}
          </div>
        </Glass>
      )}
      <Tap onTap={scan} off={scanning} vt="med" style={{width:"100%",padding:"16px",borderRadius:18,textAlign:"center",background:scanning?"rgba(16,185,129,0.06)":"rgba(16,185,129,0.11)",border:`1px solid rgba(16,185,129,${scanning?.14:.42})`,color:scanning?"rgba(16,185,129,0.38)":EM,fontSize:12,fontWeight:700,letterSpacing:3.5,boxShadow:scanning?"none":`0 0 28px rgba(16,185,129,0.14)`,transition:"all 0.3s"}}>
        {scanning?`ANALYZING… ${prog}%`:phase==="done"?"RE-SCAN FILTER":"INITIATE NEURAL SCAN"}
      </Tap>
    </div>
  );
}

