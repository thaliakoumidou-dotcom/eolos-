<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no,maximum-scale=1" />
  <meta name="theme-color" content="#000000" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="BioSmart" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="description" content="BioSmart 120g — Premium air quality monitor & biochar filter tracker" />
  <link rel="manifest" href="manifest.json" />
  <title>BioSmart 120g</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; height: 100dvh; background: #000; overflow: hidden; -webkit-text-size-adjust: 100%; }
    body { position: fixed; width: 100%; color: #fff; font-family: 'Space Grotesk', sans-serif; -webkit-font-smoothing: antialiased; overscroll-behavior: none; }
    #root { height: 100%; height: 100dvh; }
    * { -webkit-tap-highlight-color: transparent; }
    ::-webkit-scrollbar { display: none; }
    #splash { position:fixed; inset:0; background:#000; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; z-index:9999; transition:opacity 0.5s ease; }
    #splash.hide { opacity:0; pointer-events:none; }
    #splash-icon { font-size:60px; animation: splashPulse 1.4s ease infinite; }
    #splash-name { font-size:14px; font-weight:700; letter-spacing:5px; color:#10B981; font-family:'Space Grotesk',sans-serif; }
    #splash-sub  { font-size:10px; color:rgba(255,255,255,0.3); letter-spacing:3px; font-family:'Space Grotesk',sans-serif; }
    @keyframes splashPulse {
      0%,100% { transform:scale(1);   filter:drop-shadow(0 0 10px rgba(16,185,129,0.4)); }
      50%      { transform:scale(1.1); filter:drop-shadow(0 0 28px rgba(16,185,129,0.9)); }
    }
    @keyframes pageIn    { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
    @keyframes slideDown { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:translateY(0); } }
    @keyframes pulse     { 0%,100% { opacity:1; } 50% { opacity:0.25; } }
  </style>
</head>
<body>
  <div id="splash">
    <div id="splash-icon">🍃</div>
    <div id="splash-name">BIOSMART 120g</div>
    <div id="splash-sub">INITIALIZING</div>
  </div>
  <div id="root"></div>

<script type="text/babel">
const { useState, useEffect, useRef, useCallback } = React;

const DECAY = 0.0055;
const EM    = "#10B981";
const DEF   = [35.1856, 33.3823];

let _m = {};
const S = {
  g: k => { try { return localStorage.getItem(k); } catch { return _m[k]??null; } },
  s: (k,v) => { try { localStorage.setItem(k,v); } catch { _m[k]=v; } },
};

const vibe = t => { try { if(navigator.vibrate) navigator.vibrate(t==="heavy"?[40]:t==="med"?[20]:[8]); } catch{} };

function Tap({children, onTap, style={}, off=false, vt="light"}) {
  const [dn,setDn] = useState(false);
  const frd = useRef(false);
  return (
    <div style={{...style,
      transform: dn&&!off?"scale(0.95)":"scale(1)",
      transition: dn?"transform 0.08s ease":"transform 0.22s cubic-bezier(0.34,1.56,0.64,1)",
      touchAction:"manipulation", cursor:off?"default":"pointer",
      userSelect:"none", WebkitUserSelect:"none", WebkitTapHighlightColor:"transparent"}}
      onPointerDown={e=>{ if(off)return; e.currentTarget.setPointerCapture(e.pointerId); setDn(true); frd.current=false; vibe(vt); }}
      onPointerUp={()=>{ setDn(false); if(!off&&!frd.current){frd.current=true;onTap?.();} }}
      onPointerCancel={()=>setDn(false)} onPointerLeave={()=>setDn(false)}>
      {children}
    </div>
  );
}

function Gauge({val, anim}) {
  const R=110,CX=140,CY=140,SW=14;
  const circ=2*Math.PI*R, off=circ*(1-anim/100);
  const c=val>60?EM:val>30?"#F59E0B":"#EF4444";
  return (
    <svg width="280" height="280" style={{filter:`drop-shadow(0 0 28px ${c}55)`,willChange:"transform"}}>
      <defs>
        <linearGradient id="gG" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stopColor={c}/><stop offset="100%" stopColor={c} stopOpacity=".5"/>
        </linearGradient>
        <filter id="gF"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      </defs>
      <circle cx={CX} cy={CY} r={R} fill="none" stroke="rgba(255,255,255,0.06)" strokeWidth={SW}/>
      {Array.from({length:40},(_,i)=>{
        const a=(i/40)*360-90,rad=a*Math.PI/180,on=i/40<=anim/100;
        return <line key={i} x1={CX+(R-20)*Math.cos(rad)} y1={CY+(R-20)*Math.sin(rad)} x2={CX+(R-26)*Math.cos(rad)} y2={CY+(R-26)*Math.sin(rad)} stroke={on?c:"rgba(255,255,255,0.09)"} strokeWidth="1.5" strokeLinecap="round"/>;
      })}
      <circle cx={CX} cy={CY} r={R} fill="none" stroke="url(#gG)" strokeWidth={SW} strokeLinecap="round" strokeDasharray={circ} strokeDashoffset={off} transform={`rotate(-90 ${CX} ${CY})`} style={{transition:"stroke-dashoffset 1.8s cubic-bezier(0.34,1.56,0.64,1)",willChange:"stroke-dashoffset"}} filter="url(#gF)"/>
      <circle cx={CX} cy={CY} r="7" fill={c} filter="url(#gF)"/>
      <circle cx={CX} cy={CY} r="70" fill="none" stroke="rgba(255,255,255,0.03)" strokeWidth="1"/>
    </svg>
  );
}

const Glass = ({children,style={},glow=false,p=20}) => (
  <div style={{background:"rgba(255,255,255,0.04)",backdropFilter:"blur(20px)",WebkitBackdropFilter:"blur(20px)",border:"1px solid rgba(255,255,255,0.08)",borderRadius:20,padding:p,boxShadow:glow?"0 0 32px rgba(16,185,129,0.1),inset 0 1px 0 rgba(255,255,255,0.07)":"inset 0 1px 0 rgba(255,255,255,0.05)",...style}}>{children}</div>
);

const MonI  = ({a}) => <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" strokeWidth="1.5"/><circle cx="12" cy="12" r="3" fill={a?EM:"currentColor"}/><path d="M12 3v3M12 18v3M3 12h3M18 12h3" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round"/></svg>;
const SynI  = ({a}) => <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 12a9 9 0 0 1-15 6.7L3 16" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round"/><path d="M17 8h4V4M7 16H3v4" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/></svg>;
const ScanI = ({a}) => <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="6" height="6" rx="1" stroke="currentColor" strokeWidth="1.5"/><rect x="15" y="3" width="6" height="6" rx="1" stroke="currentColor" strokeWidth="1.5"/><rect x="3" y="15" width="6" height="6" rx="1" stroke="currentColor" strokeWidth="1.5"/><circle cx="18" cy="18" r="3" stroke={a?EM:"currentColor"} strokeWidth="1.5"/><circle cx="18" cy="18" r="1" fill={a?EM:"currentColor"}/></svg>;
const DocI  = ({a}) => <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" strokeWidth="1.5"/><path d="M8 8h8M8 12h8M8 16h5" stroke={a?EM:"currentColor"} strokeWidth="1.5" strokeLinecap="round"/></svg>;

function Dock({tab, setTab}) {
  const tabs = [{id:"monitor",l:"Monitor",I:MonI},{id:"biosync",l:"Bio-Sync",I:SynI},{id:"aiscan",l:"AI Scan",I:ScanI},{id:"data",l:"Datasheet",I:DocI}];
  return (
    <div style={{flexShrink:0,display:"flex",justifyContent:"center",alignItems:"flex-end",padding:"10px 16px",paddingBottom:"calc(14px + env(safe-area-inset-bottom,0px))",background:"linear-gradient(to top,rgba(0,0,0,0.98),transparent)",position:"relative",zIndex:50}}>
      <div style={{display:"flex",gap:2,background:"rgba(255,255,255,0.055)",backdropFilter:"blur(32px)",WebkitBackdropFilter:"blur(32px)",border:"1px solid rgba(255,255,255,0.1)",borderRadius:32,padding:"8px 10px",boxShadow:"0 -4px 32px rgba(0,0,0,0.5),inset 0 1px 0 rgba(255,255,255,0.08)"}}>
        {tabs.map(({id,l,I}) => {
          const on=tab===id;
          return (
            <Tap key={id} onTap={()=>setTab(id)} style={{background:on?"rgba(16,185,129,0.15)":"transparent",border:on?"1px solid rgba(16,185,129,0.32)":"1px solid transparent",borderRadius:24,padding:"10px 16px",color:on?EM:"rgba(255,255,255,0.38)",display:"flex",flexDirection:"column",alignItems:"center",gap:4,boxShadow:on?"0 0 20px rgba(16,185,129,0.28)":"none",minWidth:64,transition:"all 0.25s"}}>
              <I a={on}/><span style={{fontSize:9,fontWeight:600,letterSpacing:0.8}}>{l.toUpperCase()}</span>
            </Tap>
          );
        })}
      </div>
    </div>
  );
}

function BioMap({coords,live,place}) {
  const [ping,setPing]=useState(0);
  const raf=useRef(null),last=useRef(0);
  useEffect(()=>{
    const tick=ts=>{ if(ts-last.current>55){setPing(p=>(p+1)%100);last.current=ts;} raf.current=requestAnimationFrame(tick); };
    raf.current=requestAnimationFrame(tick);
    return()=>cancelAnimationFrame(raf.current);
  },[]);
  const W=400,H=240,seed=Math.abs(Math.round(coords[0]*1000+coords[1]*1000));
  const rng=n=>((seed*9301+n*49297+233280)%233280)/233280;
  const blk=Array.from({length:18},(_,i)=>({x:rng(i*3+1)*(W-60)+5,y:rng(i*3+2)*(H-40)+5,w:15+rng(i*3+3)*40,h:10+rng(i*5+1)*28,o:0.03+rng(i)*0.05}));
  const hs=Array.from({length:8},(_,i)=>({y:20+rng(i*13)*(H-40),o:0.08+rng(i)*0.12,w:0.5+rng(i*7)*1.5}));
  const vs=Array.from({length:10},(_,i)=>({x:10+rng(i*17+5)*(W-20),o:0.08+rng(i+3)*0.12,w:0.5+rng(i*11)*1.5}));
  const mY=H*0.45+rng(99)*30,mX=W*0.3+rng(88)*60;
  const pR=10+(ping/100)*52,pO=(1-ping/100)*0.65;
  return (
    <div style={{position:"relative",borderRadius:14,overflow:"hidden",height:H,border:"1px solid rgba(16,185,129,0.28)",background:"#040c08"}}>
      <svg width="100%" height="100%" viewBox={`0 0 ${W} ${H}`} style={{position:"absolute",inset:0}}>
        <defs>
          <radialGradient id="mv" cx="50%" cy="50%" r="55%"><stop offset="0%" stopColor="transparent"/><stop offset="100%" stopColor="rgba(0,0,0,0.72)"/></radialGradient>
          <radialGradient id="mg" cx="50%" cy="50%" r="60%"><stop offset="0%" stopColor="rgba(16,185,129,0.07)"/><stop offset="100%" stopColor="transparent"/></radialGradient>
        </defs>
        <rect width={W} height={H} fill="#040c08"/>
        <rect width={W} height={H} fill="url(#mg)"/>
        {Array.from({length:18},(_,i)=><line key={`gv${i}`} x1={i*(W/18)} y1="0" x2={i*(W/18)} y2={H} stroke="rgba(16,185,129,0.04)" strokeWidth=".5"/>)}
        {Array.from({length:11},(_,i)=><line key={`gh${i}`} x1="0" y1={i*(H/11)} x2={W} y2={i*(H/11)} stroke="rgba(16,185,129,0.04)" strokeWidth=".5"/>)}
        {blk.map((b,i)=><rect key={i} x={b.x} y={b.y} width={b.w} height={b.h} fill={`rgba(16,185,129,${b.o})`} rx="1"/>)}
        {hs.map((s,i)=><line key={`h${i}`} x1="0" y1={s.y} x2={W} y2={s.y} stroke={`rgba(16,185,129,${s.o})`} strokeWidth={s.w}/>)}
        {vs.map((s,i)=><line key={`v${i}`} x1={s.x} y1="0" x2={s.x} y2={H} stroke={`rgba(16,185,129,${s.o})`} strokeWidth={s.w}/>)}
        <line x1="0" y1={mY} x2={W} y2={mY} stroke="rgba(16,185,129,0.3)" strokeWidth="2.5"/>
        <line x1={mX} y1="0" x2={mX} y2={H} stroke="rgba(16,185,129,0.22)" strokeWidth="2"/>
        <circle cx={W/2} cy={H/2} r={pR} fill="none" stroke={EM} strokeWidth="1" opacity={pO}/>
        <circle cx={W/2} cy={H/2} r={pR*.55} fill="none" stroke={EM} strokeWidth=".7" opacity={pO*.5}/>
        <circle cx={W/2} cy={H/2} r="7" fill={EM} opacity=".9"/>
        <circle cx={W/2} cy={H/2} r="3" fill="#fff"/>
        <rect width={W} height={H} fill="url(#mv)"/>
      </svg>
      <div style={{position:"absolute",top:"50%",left:"50%",transform:"translate(-50%,-135%)",zIndex:10,pointerEvents:"none"}}>
        <div style={{background:"rgba(0,0,0,0.9)",backdropFilter:"blur(12px)",WebkitBackdropFilter:"blur(12px)",border:"1px solid rgba(16,185,129,0.4)",borderRadius:9,padding:"5px 12px",whiteSpace:"nowrap"}}>
          <span style={{fontSize:11,color:"#fff",fontWeight:700}}>📍 {place}</span>
        </div>
        <div style={{width:1,height:14,background:`linear-gradient(${EM},transparent)`,margin:"0 auto"}}/>
      </div>
      <div style={{position:"absolute",top:10,left:10,right:10,display:"flex",justifyContent:"space-between",zIndex:10,pointerEvents:"none"}}>
        <div style={{background:"rgba(0,0,0,0.85)",backdropFilter:"blur(8px)",WebkitBackdropFilter:"blur(8px)",border:`1px solid rgba(16,185,129,${live?.4:.2})`,borderRadius:8,padding:"5px 10px",display:"flex",alignItems:"center",gap:6}}>
          <div style={{width:6,height:6,borderRadius:"50%",background:live?EM:"#F59E0B",animation:"pulse 1.8s ease infinite"}}/>
          <span style={{fontSize:9,color:live?EM:"#F59E0B",fontWeight:700,letterSpacing:1.5}}>{live?"GPS LIVE":"DEFAULT"}</span>
        </div>
        <div style={{background:"rgba(0,0,0,0.85)",backdropFilter:"blur(8px)",WebkitBackdropFilter:"blur(8px)",border:"1px solid rgba(255,255,255,0.07)",borderRadius:8,padding:"5px 10px"}}>
          <span style={{fontSize:9,color:"rgba(255,255,255,0.35)",letterSpacing:1}}>ENCRYPTED</span>
        </div>
      </div>
      <div style={{position:"absolute",bottom:10,left:10,right:10,display:"flex",justifyContent:"space-between",zIndex:10,pointerEvents:"none"}}>
        <div style={{background:"rgba(0,0,0,0.8)",backdropFilter:"blur(8px)",WebkitBackdropFilter:"blur(8px)",border:"1px solid rgba(255,255,255,0.06)",borderRadius:8,padding:"4px 10px"}}>
          <span style={{fontSize:9,color:"rgba(255,255,255,0.4)",fontFamily:"monospace"}}>{coords[0].toFixed(4)}°N {coords[1].toFixed(4)}°E</span>
        </div>
        <div style={{background:"rgba(0,0,0,0.8)",backdropFilter:"blur(8px)",WebkitBackdropFilter:"blur(8px)",border:"1px solid rgba(16,185,129,0.2)",borderRadius:8,padding:"4px 10px"}}>
          <span style={{fontSize:9,color:EM,fontWeight:700,letterSpacing:1}}>BIO-ZONE ●</span>
        </div>
      </div>
    </div>
  );
}

function MonitorPage({life,anim,taps,onTap}) {
  const c=life>60?EM:life>30?"#F59E0B":"#EF4444";
  const lbl=life>60?"OPTIMAL":life>30?"DEGRADING":"REPLACE";
  const mx=[{l:"PM2.5",v:"6 μg",s:"Excellent"},{l:"CO₂",v:"412 ppm",s:"Normal"},{l:"VOC",v:"0.08",s:"Low"},{l:"HUMID",v:"54%",s:"Ideal"}];
  return (
    <div style={{padding:"0 16px 16px"}}>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",paddingTop:"max(52px, env(safe-area-inset-top, 20px))",paddingBottom:18}}>
        <div>
          <p style={{fontSize:10,letterSpacing:3,color:"rgba(255,255,255,0.28)",fontWeight:600,marginBottom:4}}>ENVIRONMENT MONITOR</p>
          <h1 style={{fontSize:24,fontWeight:800,letterSpacing:-0.8}}>BioSmart <span style={{color:EM}}>120g</span></h1>
        </div>
        <Tap onTap={onTap} vt="heavy" style={{width:44,height:44,borderRadius:14,background:taps>0?`rgba(16,185,129,${Math.min(taps*0.18,0.7)})`:"rgba(255,255,255,0.06)",border:`1px solid rgba(16,185,129,${taps*0.25+0.12})`,display:"flex",alignItems:"center",justifyContent:"center",boxShadow:taps>0?`0 0 ${taps*10}px rgba(16,185,129,0.5)`:"none",fontSize:20,transition:"all 0.2s"}}>🍃</Tap>
      </div>
      <Glass glow style={{marginBottom:12,display:"flex",flexDirection:"column",alignItems:"center"}} p={24}>
        <p style={{fontSize:10,letterSpacing:3,color:"rgba(255,255,255,0.28)",fontWeight:600,marginBottom:10}}>FILTER LIFE REMAINING</p>
        <div style={{position:"relative",display:"inline-flex",alignItems:"center",justifyContent:"center"}}>
          <Gauge val={life} anim={anim}/>
          <div style={{position:"absolute",textAlign:"center",pointerEvents:"none"}}>
            <div style={{fontSize:50,fontWeight:800,letterSpacing:-3,color:c,lineHeight:1,textShadow:`0 0 32px ${c}77`}}>{Math.round(anim)}</div>
            <div style={{fontSize:12,color:"rgba(255,255,255,0.28)",fontWeight:500,marginTop:2}}>percent</div>
            <div style={{marginTop:8,fontSize:9,fontWeight:700,letterSpacing:3.5,color:c,background:`${c}1a`,border:`1px solid ${c}44`,borderRadius:100,padding:"3px 12px",display:"inline-block"}}>{lbl}</div>
          </div>
        </div>
        <div style={{display:"flex",width:"100%",marginTop:4,paddingTop:14,borderTop:"1px solid rgba(255,255,255,0.05)"}}>
          {[["DECAY/DAY","0.55%","#F59E0B"],["DAYS LEFT",`${Math.round(life/DECAY)}`,EM],["AQI","28",EM]].map(([l,v,col],i)=>(
            <div key={l} style={{flex:1,textAlign:"center",borderLeft:i>0?"1px solid rgba(255,255,255,0.05)":"none"}}>
              <p style={{fontSize:9,color:"rgba(255,255,255,0.28)",letterSpacing:1.2,marginBottom:3}}>{l}</p>
              <p style={{fontSize:16,fontWeight:700,color:col}}>{v}</p>
            </div>
          ))}
        </div>
      </Glass>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}}>
        {mx.map(({l,v,s})=>(
          <Glass key={l} p={14}>
            <p style={{fontSize:9,letterSpacing:2,color:"rgba(255,255,255,0.28)",fontWeight:600,marginBottom:5}}>{l}</p>
            <p style={{fontSize:20,fontWeight:800,letterSpacing:-0.5,color:"#fff",marginBottom:2}}>{v}</p>
            <p style={{fontSize:10,color:EM,fontWeight:600}}>{s}</p>
          </Glass>
        ))}
      </div>
    </div>
  );
}

function BioSyncPage() {
  const [coords,setCoords]=useState(DEF);
  const [live,setLive]=useState(false);
  const [status,setStatus]=useState("acquiring");
  const [place,setPlace]=useState("Egomi, Nicosia");
  const geo=useCallback(async(lat,lng)=>{
    try{
      const r=await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&accept-language=en`);
      const d=await r.json();const a=d.address||{};
      const di=a.suburb||a.neighbourhood||a.quarter||a.village||a.city_district||"";
      const ci=a.city||a.town||a.municipality||a.county||"";
      setPlace([di,ci].filter(Boolean).join(", ")||a.country||"Unknown");
    }catch{}
  },[]);
  useEffect(()=>{
    if(!navigator.geolocation){setStatus("unavailable");geo(...DEF);return;}
    navigator.geolocation.getCurrentPosition(
      ({coords:{latitude:lat,longitude:lng}})=>{setCoords([lat,lng]);setLive(true);setStatus("live");geo(lat,lng);},
      ()=>{setLive(false);setStatus("denied");geo(...DEF);},
      {timeout:8000,maximumAge:60000,enableHighAccuracy:true}
    );
  },[]);
  const ins=[{l:"Outdoor AQI",v:"34",d:"+6 vs indoor",ok:false},{l:"Indoor AQI",v:"28",d:"−18% cleaner",ok:true},{l:"Filtration",v:"99.97%",d:"↑ Optimal",ok:true},{l:"Bio-Load",v:"Low",d:"Healthy",ok:true}];
  const sp=[65,72,58,80,74,68,76,82,70,75,78,72];
  return (
    <div style={{padding:"0 16px 16px"}}>
      <div style={{paddingTop:"max(52px, env(safe-area-inset-top, 20px))",paddingBottom:16}}>
        <p style={{fontSize:10,letterSpacing:3,color:"rgba(255,255,255,0.28)",fontWeight:600,marginBottom:4}}>ENVIRONMENT ANALYTICS</p>
        <h1 style={{fontSize:24,fontWeight:800,letterSpacing:-0.8,marginBottom:12}}>Bio<span style={{color:EM}}>Sync</span></h1>
        <div style={{display:"flex",alignItems:"center",gap:8,flexWrap:"wrap"}}>
          <div style={{width:7,height:7,borderRadius:"50%",flexShrink:0,background:status==="live"?EM:"#F59E0B",animation:"pulse 1.2s ease infinite"}}/>
          <div style={{display:"flex",alignItems:"center",gap:6,background:"rgba(16,185,129,0.09)",border:"1px solid rgba(16,185,129,0.28)",borderRadius:100,padding:"4px 14px 4px 10px"}}>
            <span style={{fontSize:12}}>📍</span>
            <span style={{fontSize:12,fontWeight:700,color:"#fff"}}>{place}</span>
          </div>
        </div>
      </div>
